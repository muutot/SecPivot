{
  "plugins": ["prettier-plugin-svelte"],
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": "*.json",
      "options": {
        "parser": "jsonc"
      }
    },
    {
      "files": ["src-tauri/*.json", "src-tauri/**/*.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
