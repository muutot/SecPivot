{
  "name": "secpivot-desktop",
  "version": "1.2.0",
  "description": "A professional, compact KeePass client built with Tauri and Rust.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "npm run format:prettier && npm run format:rust",
    "format:check": "npm run format:prettier:check && npm run format:rust:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:rust": "cargo test -j 1 --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy -j 1 --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run format:check && npm run check && npm run build && npm run test:frontend && npm run test:rust && npm run lint:rust",
    "tauri": "tauri",
    "version": "node scripts/version.mjs",
    "changelog": "node scripts/changelog.mjs",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
