# tauri-plugin copies its Android API shim into local plugin crates at build time.
/src-tauri/plugins/*/android/.tauri
/src-tauri/plugins/*/target
/src-tauri/plugins/*/Cargo.lock
# tauri-plugin regenerates the permission reference + schema on every build.
/src-tauri/plugins/*/permissions/autogenerated
/src-tauri/plugins/*/permissions/schemas
/app-icon.png
/dist

