+#[cfg(feature = "_merge")]
+fn same_attachment_version_layout(a: &Entry, b: &Entry) -> bool {
+    match (&a.history, &b.history) {
+        (None, None) => true,
+        (Some(a), Some(b)) => {
+            a.entries.len() == b.entries.len()
+                && a.entries
+                    .iter()
+                    .zip(&b.entries)
+                    .all(|(a, b)| same_attachment_version_layout(a, b))
+        }
+        _ => false,
+    }
+}
