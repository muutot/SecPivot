+        for id in [ROOT_GROUP_ID, GROUP1_ID] {
+            let mut group = dest.group_mut(id).unwrap();
+            group.times.last_modification = Some(Times::epoch());
+            group.times.location_changed = Some(Times::epoch());
+        }
