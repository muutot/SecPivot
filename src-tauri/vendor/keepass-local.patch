+    #[test]
+    fn secpivot_shared_attachment_keeps_other_entry_and_history_alive() {
+        let mut db = Database::new();
+        let (first, attachment_id) = {
+            let mut root = db.root_mut();
+            let mut entry = root.add_entry();
+            let attachment_id = entry
+                .add_attachment("shared.txt", Value::protected(b"synthetic-old".to_vec()))
+                .id();
+            (entry.id(), attachment_id)
+        };
+        let second = db.root_mut().add_entry().id();
+        db.entries
+            .get_mut(&second)
+            .unwrap()
+            .attachments
+            .insert("shared.txt".into(), attachment_id);
+        db.attachments
+            .get_mut(&attachment_id)
+            .unwrap()
+            .entries
+            .insert((second, None));
+        db.entry_mut(first).unwrap().edit_tracking(|tracked| {
+            tracked
+                .as_mut()
+                .add_attachment("shared.txt", Value::protected(b"synthetic-new".to_vec()));
+        });
+        assert_eq!(db.num_attachments(), 2);
+        let entry = db.entry(first).unwrap();
+        let historical = entry.historical(0).unwrap();
+        assert_eq!(
+            historical
+                .attachment_by_name("shared.txt")
+                .unwrap()
+                .get()
+                .as_slice(),
+            b"synthetic-old"
+        );
+        assert_eq!(
+            db.attachment(attachment_id).unwrap().entries(true).count(),
+            2
+        );
+        db.entry_mut(second)
+            .unwrap()
+            .remove_attachment_by_name("shared.txt");
+        assert_eq!(
+            db.attachment(attachment_id).unwrap().entries(true).count(),
+            1
+        );
+        let mut entry = db.entry_mut(first).unwrap();
+        entry.history = None;
+        entry.reindex_attachment_history();
+        assert_eq!(db.num_attachments(), 1);
+    }
+
+    #[test]
+    fn secpivot_history_guard_unwind_preserves_the_original_binary() {
+        let mut db = Database::new();
+        let first = {
+            let mut root = db.root_mut();
+            let mut entry = root.add_entry();
+            entry.add_attachment("synthetic.txt", Value::protected(b"synthetic-old".to_vec()));
+            entry.id()
+        };
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            db.entry_mut(first).unwrap().edit_tracking(|tracked| {
+                tracked
+                    .as_mut()
+                    .add_attachment("synthetic.txt", Value::protected(b"synthetic-new".to_vec()));
+                panic!("synthetic tracked edit failure");
+            });
+        }));
+        assert!(result.is_err());
+        assert!(db.pending_history_attachments.is_empty());
+        let entry = db.entry(first).unwrap();
+        let historical = entry.historical(0).unwrap();
+        assert_eq!(
+            historical
+                .attachment_by_name("synthetic.txt")
+                .unwrap()
+                .get()
+                .as_slice(),
+            b"synthetic-old"
+        );
+    }
